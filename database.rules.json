{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "accountingV2": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['version', 'startedAt', 'legacyImported']) && newData.child('version').val() === 2",
          "products": {
            "$id": {
              ".validate": "newData.hasChildren(['id', 'title', 'categoryId', 'stock', 'price', 'revenue', 'sold']) && newData.child('id').val() === $id && newData.child('stock').isNumber() && newData.child('stock').val() >= 0 && newData.child('stock').val() % 1 === 0 && newData.child('price').isNumber() && newData.child('price').val() >= 0"
            }
          },
          "sales": {
            "$id": {
              ".validate": "!data.exists() || (newData.child('id').val() === data.child('id').val() && newData.child('productId').val() === data.child('productId').val() && newData.child('title').val() === data.child('title').val() && newData.child('categoryId').val() === data.child('categoryId').val() && newData.child('quantity').val() === data.child('quantity').val() && newData.child('price').val() === data.child('price').val() && newData.child('cost').val() === data.child('cost').val() && newData.child('createdAt').val() === data.child('createdAt').val() && newData.child('priceKind').val() === data.child('priceKind').val())"
            }
          },
          "receipts": {
            "$id": {
              ".validate": "!data.exists() || (newData.child('id').val() === data.child('id').val() && newData.child('productId').val() === data.child('productId').val() && newData.child('title').val() === data.child('title').val() && newData.child('quantity').val() === data.child('quantity').val() && newData.child('unitCost').val() === data.child('unitCost').val() && newData.child('createdAt').val() === data.child('createdAt').val())"
            }
          },
          "storefront": {
            ".validate": "newData.hasChildren(['enabled', 'title'])",
            "enabled": {
              ".validate": "newData.isBoolean()"
            },
            "title": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80"
            },
            "$other": {
              ".validate": false
            }
          },
          "publicCatalog": {
            ".read": "data.parent().child('storefront/enabled').val() === true",
            ".validate": "newData.parent().child('storefront/enabled').val() === true && newData.hasChildren(['title'])",
            "title": {
              ".validate": "newData.isString() && newData.val() === newData.parent().parent().child('storefront/title').val()"
            },
            "products": {
              "$id": {
                ".validate": "newData.hasChildren(['id','title','categoryId','categoryTitle','imageUrl','price','available']) && newData.parent().parent().parent().child('products').child($id).exists() && newData.parent().parent().parent().child('products').child($id).child('archived').val() === false",
                "id": {
                  ".validate": "newData.val() === newData.parent().parent().parent().parent().child('products').child($id).child('id').val()"
                },
                "title": {
                  ".validate": "newData.val() === newData.parent().parent().parent().parent().child('products').child($id).child('title').val()"
                },
                "categoryId": {
                  ".validate": "newData.val() === newData.parent().parent().parent().parent().child('products').child($id).child('categoryId').val()"
                },
                "price": {
                  ".validate": "newData.val() === newData.parent().parent().parent().parent().child('products').child($id).child('price').val()"
                },
                "imageUrl": {
                  ".validate": "newData.isString() && (newData.val() === '' || newData.val() === newData.parent().parent().parent().parent().child('products').child($id).child('imageUrl').val())"
                },
                "available": {
                  ".validate": "newData.isBoolean() && newData.val() === (newData.parent().parent().parent().parent().child('products').child($id).child('stock').val() > 0)"
                },
                "categoryTitle": {
                  ".validate": "newData.isString() && newData.val() === newData.parent().parent().parent().parent().child('categories').child(newData.parent().parent().parent().parent().child('products').child($id).child('categoryId').val()).child('title').val()"
                },
                "$other": {
                  ".validate": false
                }
              }
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    }
  }
}
